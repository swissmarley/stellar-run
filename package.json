{
  "name": "stellar-run",
  "version": "0.1.0",
  "private": true,
  "description": "STELLAR RUN - an open-source, portrait, one-handed endless space runner for the web.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --strictPort",
    "lint": "biome check . && tsc -p .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "bot": "node tools/bot.ts",
    "bench": "node tools/bench.ts",
    "docs:tuning": "node tools/tuning-doc.ts",
    "icons": "node tools/icons.ts",
    "ci": "npm run lint && npm test && npm run bot -- --runs 100 && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "1.63",
    "@types/node": "^22.20.5",
    "@types/three": "^0.186.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
